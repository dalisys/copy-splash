{
  "manifest_version": 3,
  "name": "Unsplash Customizer (prev. CopySplash)",
  "version": "1.2.9",
  "description": "Customize Unsplash images, get a link or download them with a click!",
  "permissions": ["clipboardWrite", "storage", "downloads"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://unsplash.com/*"],
      "js": ["content.js"]
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Unsplash Customizer\nClick to set image settings",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
